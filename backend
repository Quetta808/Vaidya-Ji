// 1. Core Framework Imports
const express = require('express');
const dotenv = require('dotenv');
const cors = require('cors');
const helmet = require('helmet');
const rateLimit = require('express-rate-limit');

// 2. Load Secret Configurations
dotenv.config();

// 3. Initialize the Server Application
const app = express();

// 4. Global Security Systems
app.use(helmet()); 

app.use(cors({
    origin: 'http://localhost:3000', // Allows your future frontend to talk to this backend
    credentials: true
}));

app.use(express.json({ limit: '10kb' })); // Safety shield against oversized hacker inputs

// 5. Rate Limiting (Prevents bots from crashing your website)
const limiter = rateLimit({
    windowMs: 15 * 60 * 1000, // 15 minutes
    max: 100, // A single user can only send 100 requests every 15 minutes
    message: 'Too many requests, please try again later.'
});
app.use('/api/', limiter);

// 6. Server Health Check Route
app.get('/api/health', (req, res) => {
    res.status(200).json({
        status: 'success',
        message: 'VAIDYA JI backend is running safely and securely!'
    });
});

// 7. Boot up the server
const PORT = process.env.PORT || 5000;
app.listen(PORT, () => {
    console.log(`Server safely operating on port ${PORT}`);
});
